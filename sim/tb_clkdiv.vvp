#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
S_0x55dcc6edffa0 .scope module, "tb_clkdiv" "tb_clkdiv" 2 7;
 .timescale -9 -12;
v0x55dcc6f09d40_0 .var "clk", 0 0;
v0x55dcc6f09e00_0 .var "div", 7 0;
v0x55dcc6f09ed0_0 .var "enable", 0 0;
v0x55dcc6f09fd0_0 .var/i "pulse_count", 31 0;
v0x55dcc6f0a070_0 .var "rst_n", 0 0;
v0x55dcc6f0a160_0 .net "sclk_en", 0 0, v0x55dcc6f09be0_0;  1 drivers
E_0x55dcc6eb7d90 .event posedge, v0x55dcc6ef2f60_0;
S_0x55dcc6ef2d60 .scope module, "dut" "spi_clkdiv" 2 15, 3 6 0, S_0x55dcc6edffa0;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "clk";
    .port_info 1 /INPUT 1 "rst_n";
    .port_info 2 /INPUT 1 "enable";
    .port_info 3 /INPUT 8 "div";
    .port_info 4 /OUTPUT 1 "sclk_en";
v0x55dcc6ef2f60_0 .net "clk", 0 0, v0x55dcc6f09d40_0;  1 drivers
v0x55dcc6f09840_0 .var "count", 7 0;
v0x55dcc6f09920_0 .net "div", 7 0, v0x55dcc6f09e00_0;  1 drivers
v0x55dcc6f09a10_0 .net "enable", 0 0, v0x55dcc6f09ed0_0;  1 drivers
v0x55dcc6f09ad0_0 .net "rst_n", 0 0, v0x55dcc6f0a070_0;  1 drivers
v0x55dcc6f09be0_0 .var "sclk_en", 0 0;
E_0x55dcc6eb7b40/0 .event negedge, v0x55dcc6f09ad0_0;
E_0x55dcc6eb7b40/1 .event posedge, v0x55dcc6ef2f60_0;
E_0x55dcc6eb7b40 .event/or E_0x55dcc6eb7b40/0, E_0x55dcc6eb7b40/1;
    .scope S_0x55dcc6ef2d60;
T_0 ;
    %wait E_0x55dcc6eb7b40;
    %load/vec4 v0x55dcc6f09ad0_0;
    %nor/r;
    %flag_set/vec4 8;
    %jmp/0xz  T_0.0, 8;
    %pushi/vec4 0, 0, 8;
    %assign/vec4 v0x55dcc6f09840_0, 0;
    %pushi/vec4 0, 0, 1;
    %assign/vec4 v0x55dcc6f09be0_0, 0;
    %jmp T_0.1;
T_0.0 ;
    %load/vec4 v0x55dcc6f09a10_0;
    %nor/r;
    %flag_set/vec4 8;
    %jmp/0xz  T_0.2, 8;
    %pushi/vec4 0, 0, 8;
    %assign/vec4 v0x55dcc6f09840_0, 0;
    %pushi/vec4 0, 0, 1;
    %assign/vec4 v0x55dcc6f09be0_0, 0;
    %jmp T_0.3;
T_0.2 ;
    %load/vec4 v0x55dcc6f09840_0;
    %load/vec4 v0x55dcc6f09920_0;
    %cmp/e;
    %jmp/0xz  T_0.4, 4;
    %pushi/vec4 0, 0, 8;
    %assign/vec4 v0x55dcc6f09840_0, 0;
    %pushi/vec4 1, 0, 1;
    %assign/vec4 v0x55dcc6f09be0_0, 0;
    %jmp T_0.5;
T_0.4 ;
    %load/vec4 v0x55dcc6f09840_0;
    %addi 1, 0, 8;
    %assign/vec4 v0x55dcc6f09840_0, 0;
    %pushi/vec4 0, 0, 1;
    %assign/vec4 v0x55dcc6f09be0_0, 0;
T_0.5 ;
T_0.3 ;
T_0.1 ;
    %jmp T_0;
    .thread T_0;
    .scope S_0x55dcc6edffa0;
T_1 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x55dcc6f09d40_0, 0, 1;
    %end;
    .thread T_1;
    .scope S_0x55dcc6edffa0;
T_2 ;
    %delay 5000, 0;
    %load/vec4 v0x55dcc6f09d40_0;
    %inv;
    %store/vec4 v0x55dcc6f09d40_0, 0, 1;
    %jmp T_2;
    .thread T_2;
    .scope S_0x55dcc6edffa0;
T_3 ;
    %vpi_call 2 28 "$dumpfile", "tb_clkdiv.vcd" {0 0 0};
    %vpi_call 2 29 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x55dcc6edffa0 {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x55dcc6f0a070_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x55dcc6f09ed0_0, 0, 1;
    %pushi/vec4 3, 0, 8;
    %store/vec4 v0x55dcc6f09e00_0, 0, 8;
    %delay 20000, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x55dcc6f0a070_0, 0, 1;
    %delay 10000, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x55dcc6f09ed0_0, 0, 1;
    %delay 500000, 0;
    %vpi_call 2 41 "$display", "TB_CLKDIV: simulation finished. Check waveform for sclk_en pulse spacing." {0 0 0};
    %vpi_call 2 42 "$finish" {0 0 0};
    %end;
    .thread T_3;
    .scope S_0x55dcc6edffa0;
T_4 ;
    %pushi/vec4 0, 0, 32;
    %store/vec4 v0x55dcc6f09fd0_0, 0, 32;
    %end;
    .thread T_4;
    .scope S_0x55dcc6edffa0;
T_5 ;
    %wait E_0x55dcc6eb7d90;
    %load/vec4 v0x55dcc6f0a160_0;
    %flag_set/vec4 8;
    %jmp/0xz  T_5.0, 8;
    %load/vec4 v0x55dcc6f09fd0_0;
    %addi 1, 0, 32;
    %store/vec4 v0x55dcc6f09fd0_0, 0, 32;
    %vpi_call 2 51 "$display", "t=%0t : sclk_en pulse #%0d", $time, v0x55dcc6f09fd0_0 {0 0 0};
T_5.0 ;
    %jmp T_5;
    .thread T_5;
# The file index is used to find the file name in the following table.
:file_names 4;
    "N/A";
    "<interactive>";
    "tb/tb_clkdiv.v";
    "rtl/spi_clkdiv.v";
